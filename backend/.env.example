# Cortexa Backend — Environment Variable Template
#
# COPY this file to .env and fill in real values.
# NEVER commit .env — it is listed in .gitignore.
# This file (.env.example) must ONLY contain placeholder values.
# Real secrets must never appear here, even once "redacted."

# ---------------------------------------------------------------------------
# Database
#
# Supabase: use the TRANSACTION POOLER URL (port 6543), not the direct
# connection (port 5432).  The transaction pooler is required because
# asyncpg does not support session-mode pooling.
#
# CRITICAL — the "postgres" user in DATABASE_URL is a SUPERUSER on Supabase.
# Superusers bypass RLS even with FORCE ROW LEVEL SECURITY.  This URL is
# intentionally kept as postgres so that Alembic can run DDL migrations.
# RLS enforcement comes from APP_DB_ROLE below — do NOT leave that unset.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:your-supabase-password@aws-0-region.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Redis / Job Queue (Upstash — use the rediss:// TLS URL)
# ---------------------------------------------------------------------------
REDIS_URL=rediss://default:your-upstash-token@your-host.upstash.io:6379

# ---------------------------------------------------------------------------
# Embedding (gemini-embedding-001 or gemini-embedding-2-preview)
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=your-google-api-key-here
EMBEDDING_MODEL=gemini-embedding-001

# Embedding quota / throttle controls
# EMBED_BATCH_SIZE: max texts per embed_content call (default: 16)
EMBED_BATCH_SIZE=16
# EMBED_MAX_RPM: requests per minute token-bucket rate limit (default: 60)
EMBED_MAX_RPM=60
# EMBED_MAX_TPM: tokens per minute token-bucket rate limit (default: 20000)
EMBED_MAX_TPM=20000
# EMBED_MAX_WAIT_SECONDS: cap on total 429-throttle wait per job (default: 900)
EMBED_MAX_WAIT_SECONDS=900

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_SECRET=generate-with--python-c--import-secrets-print-secrets.token_hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Migration URL — session pooler (port 5432) or direct connection for Alembic DDL migrations.
# Supabase transaction poolers (port 6543) will reject prepared statements and DDL.
# MIGRATE_URL=postgresql+asyncpg://postgres:your-supabase-password@aws-0-region.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# CORS Origins
# Comma-separated list of allowed web origins, e.g. for Vercel and local dev.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,https://cortexa-io.vercel.app
ALLOWED_ORIGINS=["http://localhost:3000","https://cortexa-io.vercel.app"]

# ---------------------------------------------------------------------------
# Embedding dimension — must match text-embedding-004 output (768)
# ---------------------------------------------------------------------------
EMBEDDING_DIM=768

# ---------------------------------------------------------------------------
# File storage directory (relative to project root; never commit files inside)
# ---------------------------------------------------------------------------
STORAGE_DIR=storage

# ---------------------------------------------------------------------------
# Ingestion worker — Redis stream block time (milliseconds)
#
# XREADGROUP blocks for this long when the stream is empty.
# socket_timeout is set to (WORKER_BLOCK_MS / 1000) + 10 s automatically,
# so the TCP socket never expires during a legitimate blocked read.
#
# Default (production): 30 000 ms (30 seconds)
# Tests use 2 000 ms via .env.test for fast teardown.
# ---------------------------------------------------------------------------
WORKER_BLOCK_MS=30000


# ---------------------------------------------------------------------------
# App database role — NON-NEGOTIABLE IN PRODUCTION
#
# This MUST be set to "cortexa_app" (the role created by migration 0005).
# Leaving it unset means the SET LOCAL ROLE line in database.py never fires,
# the connection stays as the "postgres" superuser, and FORCE ROW LEVEL
# SECURITY is silently bypassed — RLS does nothing, every tenant can read
# every other tenant's data.
#
# How it works:
#   - DATABASE_URL connects as "postgres" (superuser) for Alembic DDL access.
#   - At the START of every tenant_session() and platform_session() transaction,
#     database.py executes: SET LOCAL ROLE cortexa_app
#   - "cortexa_app" has NOSUPERUSER + NOBYPASSRLS (verified by migration 0005),
#     so Postgres enforces RLS policies for the duration of that transaction.
#   - SET LOCAL automatically resets to "postgres" at COMMIT/ROLLBACK — it
#     cannot leak across requests on a pooled connection.
#
# This is NOT optional.  Do not leave it blank.  Do not set it to "postgres".
# ---------------------------------------------------------------------------
APP_DB_ROLE=cortexa_app
