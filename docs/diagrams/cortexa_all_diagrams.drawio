        <mxCell id="cls-audit" value="&lt;b&gt;AuditLog&lt;/b&gt;&#xa;&lt;hr&gt;&#xa;+ id: UUID [PK]&#xa;+ tenant_id: UUID [FK]&#xa;+ actor_id: UUID&#xa;+ action: String&#xa;+ details: JSONB&#xa;+ created_at: DateTime&#xa;&lt;hr&gt;&#xa;+ record_event()" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#1e293b;strokeColor=#f59e0b;fontColor=#f8fafc;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="190" height="150" as="geometry" /></mxCell>
        <mxCell id="rel-1" value="1..* contains" style="endArrow=diamondThin;endFill=1;endSize=14;html=1;strokeColor=#38bdf8;fontColor=#f8fafc;strokeWidth=1.5;" edge="1" parent="1" source="cls-tenant" target="cls-user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rel-2" value="1..* owns" style="endArrow=diamondThin;endFill=1;endSize=14;html=1;strokeColor=#38bdf8;fontColor=#f8fafc;strokeWidth=1.5;" edge="1" parent="1" source="cls-tenant" target="cls-bot"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rel-3" value="1..* assigns" style="endArrow=diamondThin;endFill=1;endSize=14;html=1;strokeColor=#818cf8;fontColor=#f8fafc;strokeWidth=1.5;" edge="1" parent="1" source="cls-bot" target="cls-document"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rel-4" value="1..* versions" style="endArrow=diamondThin;endFill=1;endSize=14;html=1;strokeColor=#34d399;fontColor=#f8fafc;strokeWidth=1.5;" edge="1" parent="1" source="cls-document" target="cls-docver"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rel-5" value="1..* generates" style="endArrow=diamondThin;endFill=1;endSize=14;html=1;strokeColor=#f59e0b;fontColor=#f8fafc;strokeWidth=1.5;" edge="1" parent="1" source="cls-docver" target="cls-chunk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rel-6" value="1..* tracks" style="endArrow=diamondThin;endFill=1;endSize=14;html=1;strokeColor=#38bdf8;fontColor=#f8fafc;strokeWidth=1.5;" edge="1" parent="1" source="cls-tenant" target="cls-audit"><mxGeometry relative="1" as="geometry" /></mxCell>
