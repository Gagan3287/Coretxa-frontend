# Cortexa Frontend — Environment Variables Template
#
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), set these in the Project Settings -> Environment Variables.

# ---------------------------------------------------------------------------
# Backend API Base URL
# Local: http://localhost:8000
# Production: https://<your-render-app>.onrender.com (without trailing slash)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Embeddable Chat Widget Script URL
# The hosted JavaScript bundle that end users include on their websites.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WIDGET_SRC=https://widget.cortexa.io/cortexa-widget.js

# ---------------------------------------------------------------------------
# Standalone Hosted Chat URL
# The web app domain hosting dedicated full-page bot chat sessions.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_HOSTED_CHAT_URL=https://chat.cortexa.io
